# --- builder: root, full install ---
  FROM public.ecr.aws/docker/library/node:25 AS builder
  WORKDIR /app
  COPY package.json package-lock.json ./
  COPY .npmrc ./
  # TO DEVELOPERS:
  # If `npm ci` causes issues, try `npm install` instead
  # and notify Marcel Jacquot on Slack of your error
  RUN npm ci

  # --- runtime: non-root, copy artifacts from builder ---
  FROM public.ecr.aws/docker/library/node:25
  WORKDIR /app
  COPY package.json package-lock.json ./
  COPY --from=builder /app/node_modules ./node_modules
  RUN chown -R node:node /app
  USER node
  CMD ["npm", "run", "dev"]
  # For ssl    CMD ["npm", "run", "dev-ssl"]
